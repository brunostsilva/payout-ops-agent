{
  "uid": "payout-ops-agent",
  "title": "Payout Ops Agent",
  "tags": ["payout-ops-agent"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Agent questions per minute",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(payout_agent_ask_seconds_count[5m])) * 60", "legendFormat": "questions" },
        { "refId": "B", "expr": "sum(rate(payout_agent_ask_seconds_count{error!=\"none\"}[5m])) * 60", "legendFormat": "failed" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Agent average answer time",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(payout_agent_ask_seconds_sum[5m])) / sum(rate(payout_agent_ask_seconds_count[5m]))",
          "legendFormat": "average"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Hold proposals by outcome (last hour)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome, proposed_by) (increase(payout_holds_proposed_total[1h]))",
          "legendFormat": "{{outcome}} ({{proposed_by}})"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Hold decisions (last hour)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (increase(payout_holds_decided_total[1h]))", "legendFormat": "{{status}}" },
        { "refId": "B", "expr": "sum(increase(payout_holds_decision_conflicts_total[1h]))", "legendFormat": "conflicts" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP requests per second by status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
